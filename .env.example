# Whereabouts configuration. Copy to .env and fill in real values.

# Public address for the API. Local dev: ":80". Production: your domain.
SITE_ADDRESS=:80

# Optional public address for ntfy (UnifiedPush), e.g. push.example.com.
PUSH_ADDRESS=

# PostgreSQL password (also used as the API's DB password).
POSTGRES_PASSWORD=change-me

# PostgreSQL connection string for the API. Leave unset to use the docker-compose
# default (sslmode=disable, for local dev). In production (APP_ENV=production),
# set this explicitly with sslmode=require or sslmode=verify-full.
# DATABASE_URL=postgres://whereabouts:change-me@postgres:5432/whereabouts?sslmode=require

# JWT signing secret. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# CORS origin for the API (optional; leave empty for same-origin only).
ALLOWED_ORIGIN=

# Public base URL for ntfy (must be https:// in production for UnifiedPush).
NTFY_BASE_URL=http://localhost:2586

# Deployment environment: "development" (default) or "production".
# Production fails fast on insecure defaults (weak JWT secret, sslmode=disable).
APP_ENV=development

# The API runs behind Caddy, which terminates TLS. Set true so the API accepts
# plain HTTP on the private Docker network. Leave unset only if you run the API
# with its own TLS cert (TLS_CERT_FILE/TLS_KEY_FILE).
TLS_BEHIND_PROXY=true

# Direct HTTPS cert/key (optional; only used when NOT behind a proxy). Caddy is
# the recommended TLS path, so these are normally left empty.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Explicit opt-out of TLS (trusted private networks only). The API refuses to
# serve cleartext location data unless TLS_BEHIND_PROXY=true, a cert is set, or
# this is true. Do not use on the public internet.
INSECURE_HTTP=false

# Include the tracked user's name in push payloads. Default (false) omits the
# name for privacy ("A family member arrived at School").
VERBOSE_PUSH=false

# APNs (iOS push). Leave empty to disable iOS push (Android still works via
# ntfy). Requires an Apple Developer account and an APNs auth key (.p8).
# When running under Docker, mount the key into the container (see the commented
# volume in docker-compose.yml) and set this to the container path:
#   APNS_KEY_FILE=/apns/AuthKey.p8
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRODUCTION=false

# --- Platform admin panel + closed registration ---
# A platform admin is distinct from a family admin: it can see ALL families and
# members on one map, move members between families, generate invite codes, and
# manage APK builds, via the /api/admin/* API and the admin web panel served at
# /admin/ (with a catch-all fallback to index.html).
#
# PLATFORM_ADMIN_EMAIL bootstraps the FIRST platform admin. On startup the
# server promotes the user with this email to platform_admin=true (idempotent,
# every restart). If no user with that email exists yet, the server AUTO-CREATES
# the account (using PLATFORM_ADMIN_PASSWORD) so the admin is the first user to
# log in — no open registration is needed to bootstrap the server. The match is
# case-insensitive on the lowercased email column.
#
# Setting PLATFORM_ADMIN_EMAIL also CLOSES open registration: new users must
# register with a valid invite code (generated by a family admin in the app, or
# by the platform admin in the web panel). Leave empty to keep open registration
# (and disable the admin panel).
PLATFORM_ADMIN_EMAIL=

# Password for the auto-created first admin account. Only used when
# PLATFORM_ADMIN_EMAIL is set and no user with that email exists yet. If empty
# and the account does not exist, the server logs an error and skips creation
# (you must register the user manually first, as before).
PLATFORM_ADMIN_PASSWORD=

# Directory served by GET /api/admin/apk. The APK is built in CI (see
# .github/workflows/apk.yml) and copied here; the server only serves it, it does
# not build. Empty disables APK download (the endpoint returns a clear error).
# Use an absolute path or a path resolvable from the API's working directory.
APK_DIR=

# Flutter project root (containing pubspec.yaml) used by POST /api/admin/apk/build
# to run "flutter build apk" ON THE SERVER. This is optional and only for dev
# machines with Flutter installed; production uses the CI-built APK in APK_DIR.
# Defaults to ./app (the repo's Flutter app). The build is only attempted when
# the flutter binary is on PATH.
FLUTTER_APP_DIR=./app
