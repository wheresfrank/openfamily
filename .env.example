# Whereabouts configuration. Copy to .env and fill in real values.

# Public address for the API. Local dev: ":80". Production: your domain.
SITE_ADDRESS=:80

# Optional public address for ntfy (UnifiedPush), e.g. push.example.com.
PUSH_ADDRESS=

# PostgreSQL password (also used as the API's DB password).
POSTGRES_PASSWORD=change-me

# PostgreSQL connection string for the API. Leave unset to use the docker-compose
# default (sslmode=disable, for local dev). In production (APP_ENV=production),
# set this explicitly with sslmode=require or sslmode=verify-full.
# DATABASE_URL=postgres://whereabouts:change-me@postgres:5432/whereabouts?sslmode=require

# JWT signing secret. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# CORS origin for the API (optional; leave empty for same-origin only).
ALLOWED_ORIGIN=

# Public base URL for ntfy (must be https:// in production for UnifiedPush).
NTFY_BASE_URL=http://localhost:2586

# Deployment environment: "development" (default) or "production".
# Production fails fast on insecure defaults (weak JWT secret, sslmode=disable).
APP_ENV=development

# The API runs behind Caddy, which terminates TLS. Set true so the API accepts
# plain HTTP on the private Docker network. Leave unset only if you run the API
# with its own TLS cert (TLS_CERT_FILE/TLS_KEY_FILE).
TLS_BEHIND_PROXY=true

# Direct HTTPS cert/key (optional; only used when NOT behind a proxy). Caddy is
# the recommended TLS path, so these are normally left empty.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Explicit opt-out of TLS (trusted private networks only). The API refuses to
# serve cleartext location data unless TLS_BEHIND_PROXY=true, a cert is set, or
# this is true. Do not use on the public internet.
INSECURE_HTTP=false

# Include the tracked user's name in push payloads. Default (false) omits the
# name for privacy ("A family member arrived at School").
VERBOSE_PUSH=false

# APNs (iOS push). Leave empty to disable iOS push (Android still works via
# ntfy). Requires an Apple Developer account and an APNs auth key (.p8).
# When running under Docker, mount the key into the container (see the commented
# volume in docker-compose.yml) and set this to the container path:
#   APNS_KEY_FILE=/apns/AuthKey.p8
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRODUCTION=false
