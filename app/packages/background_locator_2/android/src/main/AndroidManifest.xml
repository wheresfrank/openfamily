<manifest package="yukams.app.background_locator_2">
    <application>
        <!-- Fires on the repeating liveness alarm (see HeartbeatScheduler). -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- Receives movement-state transitions from Play Services. -->
        <receiver
            android:name=".ActivityTransitionsReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
