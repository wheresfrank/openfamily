# Caddy reverse proxy for Whereabouts.
#
# SITE_ADDRESS: the public address for the API (e.g. "whereabouts.example.com"
# for production with automatic HTTPS, or ":80" for local HTTP-only dev).
#
# ntfy is NOT published on the public internet in docker-compose.yml (loopback
# only). For production UnifiedPush over TLS, set:
#   PUSH_ADDRESS=push.example.com
#   NTFY_BASE_URL=https://push.example.com
#   CADDYFILE=Caddyfile.with-push
# and use caddy/Caddyfile.with-push.

{$SITE_ADDRESS:localhost} {
	encode gzip
	reverse_proxy api:8080
}
